# BFF configuration (server-only: never prefix with NEXT_PUBLIC_). Copy to .env.local for development.
# API base URL as seen from the Next.js server.
AUXILIA_API_URL=http://localhost:5080
# API URL the browser may connect to directly (SignalR), added to the CSP connect-src. Optional.
AUXILIA_API_PUBLIC_URL=
# Origin of this app as the browser sees it (CSRF Origin check). Defaults to the request origin.
AUXILIA_PUBLIC_ORIGIN=http://localhost:3000
# Client applications registered with `auxctl clients add` (web = confidential WebBff, console = PlatformConsole).
AUXILIA_WEB_CLIENT_ID=web-bff
AUXILIA_WEB_CLIENT_SECRET=
AUXILIA_CONSOLE_CLIENT_ID=console
AUXILIA_CONSOLE_CLIENT_SECRET=
# Absolute lifetime of a BFF session in seconds (the API session may end it earlier).
AUXILIA_SESSION_MAX_AGE_SECONDS=43200
