{
  "AuxiliaLogging": {
    "MinimumLevel": "Information",
    "Overrides": {
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Storage": "local-file",
    "LocalPath": "logs"
  },
  "AllowedHosts": "*",
  "Tenancy": {
    "BaseDomains": []
  }
}
